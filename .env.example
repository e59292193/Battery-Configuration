# ─────────────────────────────────────────────────────────────
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# ─────────────────────────────────────────────────────────────

# DeepSeek API Key（推荐配置在服务端，前端完全不接触密钥）
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 服务端口
PORT=3000

# 允许的跨域来源（逗号分隔；前端与后端同域托管时保持默认即可）
# 示例: https://calc.example.com,http://localhost:3000 ；* 表示允许全部
ALLOWED_ORIGINS=*

# 每 IP 每分钟最大请求数（限流）
RATE_LIMIT=30
