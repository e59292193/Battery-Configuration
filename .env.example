# ─────────────────────────────────────────────────────────────
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# ─────────────────────────────────────────────────────────────

# DeepSeek API Key（推荐配置在服务端，前端完全不接触密钥）
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 服务端口
PORT=3000

# 允许的跨域来源（逗号分隔；前端与后端同域托管时保持默认即可）
# 示例: https://calc.example.com,http://localhost:3000 ；* 表示允许全部
ALLOWED_ORIGINS=*

# 每 IP 每分钟最大请求数（限流）
RATE_LIMIT=30

# 访问口令（可选，强烈建议公网/团队部署时配置）
# 配置后，前端需在「AI 设置 → 访问口令」填写相同值才能调用 /api/chat 等接口，
# 防止陌生人消耗你的 DeepSeek 密钥额度
API_AUTH_TOKEN=

# 模型白名单（可选，逗号分隔）；留空表示只校验模型名格式
# 示例: deepseek-flash,deepseek-v4-pro
MODEL_ALLOWLIST=
